# Stranger Table runs fully locally: no Supabase, no email service, no cloud keys.
# Copy this file to .env.local and adjust if needed.

# Comma-separated emails that become campus admins when they register or sign in.
ADMIN_EMAILS=

# Where the local database (db.json) and uploaded photos are stored. Default: ./data
# DATA_DIR=./data

# Set to true only when the site is served over https.
# COOKIE_SECURE=false
